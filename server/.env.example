# Google Gemini Developer API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Text model for the agent loop. gemini-2.5-flash-lite is a solid default;
# gemini-2.5-flash and Gemma models also work (no function-calling needed).
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional fallback chain (comma-separated). Each model has its OWN free-tier
# daily bucket, so when one hits its limit the loop transparently tries the next,
# multiplying daily capacity. Keep any model used by another app off this list so
# the chat never spends that app's quota. Falls back to GEMINI_MODEL if unset.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# Embedding model for the portfolio RAG index (free tier).
EMBED_MODEL=gemini-embedding-001
