# Google Gemini Developer API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Text model for the agent loop. gemini-2.5-flash-lite is stable with a generous
# free tier; gemini-2.5-flash and Gemma models also work (no function-calling needed).
GEMINI_MODEL=gemini-2.5-flash-lite
# Embedding model for the portfolio RAG index (free tier).
EMBED_MODEL=gemini-embedding-001
