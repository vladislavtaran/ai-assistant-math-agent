# Reverse-proxy snippet — add inside your HTTPS server { } block.
# Serves the static frontend and proxies the chat API to the Python backend.

root /var/www/your-site/html;   # put web/ contents here (e.g. under /chat/)
index index.html;

location / {
    try_files $uri $uri/ =404;
}

# chatbot backend (systemd: chatbot.service on 127.0.0.1:8090)
location /chat/api/ {
    proxy_pass http://127.0.0.1:8090/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_buffering off;
}
